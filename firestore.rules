rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'beraarnab@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /postComments/{postId}/comments/{commentId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if (request.auth == null || isAdmin())
        && request.resource.data.keys().hasOnly(['name', 'message', 'postId', 'postTitle', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 1000
        && request.resource.data.postId == postId
        && request.resource.data.postTitle is string
        && request.resource.data.postTitle.size() <= 160
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }
  }
}
